# Admin login (change these before going online)
ADMIN_EMAIL=admin@kanhalibrary.com
ADMIN_PASSWORD=YourStrongPasswordHere

# Random secret for session tokens (use a long random string)
SESSION_SECRET=change-this-to-a-long-random-string

# Server port (Render sets PORT automatically)
PORT=5000

# WhatsApp alerts when a student's package ends (free via CallMeBot — see DEPLOY.md)
ADMIN_WHATSAPP=919828130420
CALLMEBOT_API_KEY=your_callmebot_api_key_here
